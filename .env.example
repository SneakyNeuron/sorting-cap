# Sorting Cap remote-provider keys (optional; local Ollama needs none).
#
# Copy this file to <workspace>/.env (default ~/SortingCap/.env), NOT to the
# repository root. `-setup` writes it for you with mode 0600.
# SORTINGCAP_WORKSPACE (the workspace location) must be set in your shell,
# not in this file, because the file is found through it.
# Environment variables with the same names override the values here.

# Novita (https://novita.ai) API key
NOVITA_API_KEY=

# Key for a custom OpenAI-compatible endpoint (leave empty if it needs none)
SORTINGCAP_OPENAI_API_KEY=

# Quarantine encryption key (Fernet). Generated by the app on first use; do not
# set it by hand. Back it up: without it, quarantined items cannot be read.
# Leave this line commented out: an invalid value is refused (an empty one
# counts as no key).
# SORTINGCAP_QUARANTINE_KEY=
